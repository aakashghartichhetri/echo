# Copy to .env.production, fill in all values, chmod 600, and never commit it.
APP_DOMAIN=echo.example.com
DATABASE_URL=postgresql://echo_user:replace_password@your-managed-db.example.com:5432/echo?schema=public&sslmode=require
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# Generate BOTH separately: openssl rand -base64 48
SESSION_SECRET=generate-a-random-48-byte-secret
INTERNAL_ORACLE_SECRET=generate-another-random-48-byte-secret
